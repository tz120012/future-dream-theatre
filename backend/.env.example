APP_MODE=local
STT_PROVIDER=browser
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# Local Whisper model files are cached in `backend/data/whisper` by default
# (Docker: the persistent `app-data` volume). The model is downloaded once and
# later starts load it from disk without any network access.
# WHISPER_MODEL_DIR=
# Set to 1 to forbid any network access when loading Whisper.
# WHISPER_LOCAL_ONLY=0
LLM_PROVIDER=siliconflow
TTS_PROVIDER=browser
IMAGE_PROVIDER=mock
RETENTION_MINUTES=30

# Optional OpenAI-compatible endpoint. Keep the key only in a local .env file.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SiliconFlow can be used for both chat and image generation.
# The web settings panel is preferred for local use; keep this key private.
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image
# Used when the teacher picks "快速卡通" on the photo page.
SILICONFLOW_IMAGE_FAST_MODEL=Tongyi-MAI/Z-Image-Turbo
# Used only when a user explicitly authorizes a captured photo as the image reference.
SILICONFLOW_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509

# Optional model download mirror for networks that cannot reach huggingface.co.
# HF_ENDPOINT=https://hf-mirror.com

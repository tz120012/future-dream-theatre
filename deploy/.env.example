# 复制成 .env 后才会生效（不复制也能正常运行，下面都是默认值）。
# 一般不需要改这里：API Key、模型选择请在网页左下角的「设置」里改，
# 那样改完立即生效，也不用重启容器。

# ---- 端口（被占用时改这里）----
# WEB_PORT=8080
# API_PORT=8000

# ---- 语音识别 ----
# local_whisper = 本机转写（默认，断网可用）；browser = 浏览器在线识别
# STT_PROVIDER=local_whisper
# base / small / tiny；换模型需要联网下载
# WHISPER_MODEL=base
# 1 = 完全禁止 Whisper 联网
# WHISPER_LOCAL_ONLY=0
# 访问不了 huggingface.co 时可换镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---- 对话与图片 ----
# template = 只用内置模板（不花钱、断网可用）；siliconflow / openai_compatible = 在线大模型
# LLM_PROVIDER=siliconflow
# mock = 不出图只用占位图；siliconflow = 真的生成插画
# IMAGE_PROVIDER=mock
# SILICONFLOW_API_KEY=
# SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image
# SILICONFLOW_IMAGE_FAST_MODEL=Tongyi-MAI/Z-Image-Turbo
# SILICONFLOW_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- 其他 ----
# 会话与生成图片在本机保留多少分钟
# RETENTION_MINUTES=30
